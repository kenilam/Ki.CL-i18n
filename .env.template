# The client's dev server, and this service's server (PORT on Cloud Run).
PORT=3500
I18N_SERVER_PORT=3501

# Where the dev server sends /api and /design: a Ki.CL deployment by default.
# KICL_HOST_URL=https://dev.ki-cl.com
# KICL_BACKEND_URL=http://localhost:3100
# KICL_DESIGN_URL=http://localhost:3200
# The token for the Ki.CL deployment's proxy, if it is used.
# KICL_CLIENT_TOKEN=
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The locales, translations and translation_runs collections. Locally, the same database as core.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=dev

# Production only: the dev service to copy translations from, since production never translates.
# TRANSLATIONS_FROM=http://localhost:3502

# The model chain that translates, Gemini first. Each provider is skipped when its key is unset.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# GROQ_TEXT_MODEL=
